{
  "name": "hilomio-memoria",
  "version": "1.0.0",
  "private": true,
  "description": "HILO MÍO · Memoria — catálogo y e-commerce de joyería con historia (Next.js + Drizzle + PostgreSQL)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:local": "tsx scripts/local-db.mts start",
    "db:local:stop": "tsx scripts/local-db.mts stop",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.mts",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:migrate:images": "tsx scripts/migrate-image-urls.mts"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
