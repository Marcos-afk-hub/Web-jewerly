# ─────────────────────────────────────────────────────────────
# HILO MÍO · Memoria — variables de entorno
# Copia este archivo a `.env.local` y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL). Obligatoria: la app falla rápido sin ella.
# Docker:  docker run -d --name memoria-pg -e POSTGRES_PASSWORD=postgres \
#            -e POSTGRES_DB=app_db -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# URL pública del sitio (usada por metadata y Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp con formato internacional, solo dígitos.
# Ejemplo México: 5215512345678
NEXT_PUBLIC_WHATSAPP_NUMBER=5215500000000

# Credenciales del panel administrativo (/admin).
# Si no se define, el panel entra en "modo demostración" con acceso de lectura.
ADMIN_PASSWORD=

# Clave para firmar los enlaces de consulta de pedidos (/rastrear).
# Sin ella, /rastrear exige número de pedido + correo.
TRACKING_SECRET=

# ── Integraciones opcionales (dejar vacío para modo demostración) ──
STRIPE_SECRET_KEY=
RESEND_API_KEY=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
