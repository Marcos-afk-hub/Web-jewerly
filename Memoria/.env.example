# ─────────────────────────────────────────────────────────────
# HILO MÍO · Memoria — variables de entorno
# Copia este archivo a `.env.local` y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL). Obligatoria: la app falla rápido sin ella.
# Local (embebido o Docker):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Producción (Neon o Supabase): pega aquí la cadena que te dan en su panel.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Ponlo en 1 solo si tu PostgreSQL local NO admite conexiones cifradas.
# En producción déjalo sin definir: Neon y Supabase exigen TLS.
# DISABLE_DB_SSL=1

# URL pública del sitio (usada por metadata, sitemap y Open Graph).
# Debe ser el dominio completo, sin barra final:
#   https://tu-sitio.vercel.app
# Si dejas el texto de ejemplo, el sitio sigue publicándose (la URL se
# valida y se usa una de reserva), pero el sitemap y las etiquetas para
# compartir en redes saldrán con una URL incorrecta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp con formato internacional, solo dígitos.
# Ejemplo México: 5215512345678
NEXT_PUBLIC_WHATSAPP_NUMBER=5215500000000

# Credenciales del panel administrativo (/admin).
# Si no se define, el panel entra en "modo demostración" con acceso de lectura.
ADMIN_PASSWORD=

# Clave para firmar los enlaces de consulta de pedidos (/rastrear).
# Sin ella, /rastrear exige número de pedido + correo.
TRACKING_SECRET=

# ── Integraciones opcionales (dejar vacío para modo demostración) ──
STRIPE_SECRET_KEY=
RESEND_API_KEY=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
